<div class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 scanlines opacity-40"></div>
  <div aria-hidden="true" class="pointer-events-none fixed inset-0" style="background: radial-gradient(60% 50% at 50% 40%, rgba(255,178,46,0.06), transparent 70%);"></div>

  <div class="reveal panel corners w-full max-w-sm px-6 py-7">
    <div class="flex items-center gap-2 mb-6">
      <span class="live-dot inline-block h-2 w-2 rounded-full bg-signal"></span>
      <span class="label-tag text-[11px] text-signal glow">AIRBAND</span>
      <span class="ml-auto font-mono text-[10px] text-ink-faint tracking-[0.2em]">RX&nbsp;//&nbsp;SECURE</span>
    </div>

    <h1 class="font-display text-lg font-semibold text-ink tracking-wide">
      ATC&nbsp;TRANSCRIBER
    </h1>
    <p class="mt-1.5 font-mono text-[11px] leading-relaxed text-ink-dim">
      Private console for reviewing and listening to recorded air-traffic clips.
    </p>

    <% if flash[:alert] %>
      <div class="mt-5 rounded-md border border-fault-dim/60 bg-fault/10 px-3 py-2 font-mono text-[11px] text-fault">
        <%= flash[:alert] %>
      </div>
    <% elsif flash[:notice] %>
      <div class="mt-5 rounded-md border border-go-dim/60 bg-go/10 px-3 py-2 font-mono text-[11px] text-go">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true, class: "mt-6 space-y-4" do |f| %>
      <div>
        <label class="label-tag block text-[10px] text-ink-dim mb-1.5">Email</label>
        <%= f.email_field :email,
              autofocus: true,
              class: "w-full panel-inset px-3 py-2 font-mono text-[13px] text-ink placeholder-ink-faint focus:outline-none focus:border-signal focus:ring-1 focus:ring-signal/40 transition" %>
      </div>

      <div>
        <label class="label-tag block text-[10px] text-ink-dim mb-1.5">Password</label>
        <%= f.password_field :password,
              class: "w-full panel-inset px-3 py-2 font-mono text-[13px] text-ink placeholder-ink-faint focus:outline-none focus:border-signal focus:ring-1 focus:ring-signal/40 transition" %>
      </div>

      <div class="pt-1">
        <%= f.submit "▸ SIGN IN",
              class: "label-tag w-full cursor-pointer rounded-md bg-signal px-3 py-2.5 text-[12px] text-base font-semibold tracking-[0.18em] shadow-[0_0_18px_-4px_rgba(255,178,46,0.6)] hover:bg-[#ffc04f] active:translate-y-px transition" %>
      </div>
    <% end %>
  </div>
</div>
